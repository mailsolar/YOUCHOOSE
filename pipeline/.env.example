# YOUCHOOSE Pipeline — Environment Variables Template
# Copy this file to .env and fill in your real values.
# NEVER commit .env to git.

# Supabase project URL
SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase ANON key (public, read-only for RLS-protected tables)
SUPABASE_ANON_KEY=your_anon_key_here

# Supabase SERVICE ROLE key (bypasses RLS — required for pipeline writes)
# Get from: Supabase Dashboard → Project Settings → API → service_role key
# KEEP THIS SECRET — never expose in frontend code
SUPABASE_SERVICE_KEY=your_service_role_key_here

# Google Gemini API key (get from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
